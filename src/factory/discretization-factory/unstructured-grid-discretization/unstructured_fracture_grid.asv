%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%DARSim Reservoir Simulator
%Author: Artur Castiel;
%TU Delft
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
classdef unstructured_fracture_grid < grid_darsim
    properties       
        dx
        A
        T
        pEDFM_alpha_T = 0; % Correction for pEDFM Connectivities
        condTrans_x % Transmisibility of heat conductivity
        I
        Por
        Centroids
        fracmesh
        aperture
        Volume
        ConnectivityMatrix
    end
    methods
        function obj = unstructured_fracture_grid(mesh)
            % Since DARSim uses only null flux condition faces transm are
            % exclusively dependent of the inner faces
            obj.fracmesh = mesh;
            obj.N = size(mesh.elements.vertices,1);
            obj.Active = ones(obj.N, 1);
            obj.ActiveTime = ones(obj.N, 1);
            obj.T = zeros(length(mesh.faces.inner.upstream),1);
            
            obj.pEDFM_alpha_T = obj.T;
            obj.condTrans_x = obj.T;
            ind = [1:size(mesh.faces.inner.upstream,1)]';
            auxmat = [ind mesh.faces.inner.upstream  ones(size(mesh.faces.inner.upstream)); ...
                ind mesh.faces.inner.downstream  -1*ones(size(mesh.faces.inner.upstream))];
            obj.ConnectivityMatrix = sparse(auxmat(:,1),auxmat(:,2),auxmat(:,3),max(auxmat(:,1)),max(auxmat(:,2)))';
        end
        function Initialize(obj, Reservoir)
            obj.dx = mean(obj.fracmesh.elements.area)^(1/2);
            obj.GridCoords = obj.fracmesh.vertex.coords;
            obj.Centroids = obj.fracmesh.elements.centroid;           
            obj.aperture = Reservoir.Thickness;
            obj.A = obj.fracmesh.elements.area;         
            obj.Volume = obj.A .*obj.aperture;
            obj.AssignNeighbours();
            obj.ComputeRockTransmissibilities(Reservoir.K);
            obj.CoarseFactor = [1, 1, 1];
            obj.DualCoarseType = zeros(obj.N, 1);
            obj.Children = cell(obj.N, 1);
            %obj.AddCoordinates();
            obj.Depth = zeros(obj.N, 1);
            %obj.ComputeDepth(true);
        end
        function Initialize_fracture(obj, Reservoir)
            obj.dx = mean(obj.fracmesh.elements.area)^(1/2);
            obj.GridCoords = obj.fracmesh.vertex.coords;
            obj.Centroids = obj.fracmesh.elements.centroid;           
            obj.aperture = Reservoir.Thickness;
            obj.A = obj.fracmesh.elements.area;         
            obj.Volume = obj.A .*obj.aperture;
            obj.AssignNeighbours();
            obj.ComputeRockTransmissibilities(Reservoir.K);
            obj.CoarseFactor = [1, 1, 1];
            obj.DualCoarseType = zeros(obj.N, 1);
            obj.Children = cell(obj.N, 1);
            obj.Por = Reservoir.Por .* ones(obj.N, 1);
            %obj.AddCoordinates();
            obj.Depth = zeros(obj.N, 1);
            %obj.ComputeDepth(true);
        end
        function ComputeRockTransmissibilities(obj, K)
            % Artur's Harmonic average of permeability.
            % K_left = K(obj.Neighbours(:,1));
            % K_right = K(obj.Neighbours(:,2));
            % P1 = obj.fracmesh.vertex.coords(obj.fracmesh.faces.inner.vertices(:,1),:);
            % P2 = obj.fracmesh.vertex.coords(obj.fracmesh.faces.inner.vertices(:,2),:);
            % centroid = 0.5*(P1+P2);
            % area = vecnorm(P1-P2,2,2).*obj.aperture;
            % H_left = vecnorm(centroid - obj.fracmesh.elements.centroid(obj.Neighbours(:,1),:),2,2);
            % H_right = vecnorm(centroid - obj.fracmesh.elements.centroid(obj.Neighbours(:,2),:),2,2);
            % KH = K_left.*K_right./((K_left.*H_right)+(K_right.*H_left));
            % %warning("Fracture Transmissbility, check the area later")
            % obj.T = area.*KH;
            % %obj.T(:) = 10^-12;

            L = obj.Neighbours(:,1);
            R = obj.Neighbours(:,2);

            P1 = obj.fracmesh.vertex.coords(obj.fracmesh.faces.inner.vertices(:,1),:);
            P2 = obj.fracmesh.vertex.coords(obj.fracmesh.faces.inner.vertices(:,2),:);

            fc = 0.5*(P1+P2);    % face center [nF x dim]
            cL = obj.fracmesh.elements.centroid(L,:);  % left cell center [nF x dim]
            cR = obj.fracmesh.elements.centroid(R,:);  % right cell center [nF x dim]
            
            t_hat  = (P2-P1) ./ max(vecnorm(P2-P1,2),1e-12);                      % [nF x dim]
            dLR  = cR - cL;
            n_raw = dLR - sum(dLR.*t_hat,2).*t_hat;
            n_hat = n_raw ./ max(vecnorm(n_raw,2,2),1e-12); 

            vL = fc - cL;
            vR = cR - fc;
            
            halfL = abs( sum(n_hat .* (K(L,:) .* vL), 2) ./ sum(vL .^ 2, 2));
            halfR = abs( sum(n_hat .* (K(R,:) .* vR), 2) ./ sum(vR .^ 2, 2));

            obj.T =  vecnorm(P1-P2,2,2) .* obj.aperture .* halfL .* halfR ./ (halfL + halfR);

        end

        function ComputeDiffusionTransmissibilities(obj, D)

            nPh = size(D, 2);

            L = obj.Neighbours(:,1);
            R = obj.Neighbours(:,2);

            fc = obj.fracmesh.faces.inner.centroid;      % [nF x dim]
            cL = obj.fracmesh.elements.centroid(L,:);    % [nF x dim]
            cR = obj.fracmesh.elements.centroid(R,:);    % [nF x dim]

            n = obj.fracmesh.faces.inner.normal;         % face normal
            n = n ./ max(vecnorm(n,2,2), 1e-12);        % unit normal

            vL = fc - cL;
            vR = cR - fc;

            area = obj.mesh.face.inner.area;
            nf = size(fc,1);

            obj.Diff = zeros(nf, nPh);

            geomL = abs(sum(n .* vL, 2) ./ (sum(vL.^2, 2) + 1e-30));   % ~ 1/dL
            geomR = abs(sum(n .* vR, 2) ./ (sum(vR.^2, 2) + 1e-30));   % ~ 1/dR

            for iph = 1:nPh
                halfL = D(L, iph) .* geomL;
                halfR = D(R, iph) .* geomR;

                obj.Diff(:, iph) = area .* halfL .* halfR ./ (halfL + halfR + 1e-30);
            end
        end

        function AddpEDFMCorrections(obj,pEDFM_alpha_T)
            obj.pEDFM_alpha_T(:) = pEDFM_alpha_T;
        end
        function CorrectTransmissibilitiesForpEDFM(obj)
            obj.T = obj.T .* (1 - obj.pEDFM_alpha_T);
        end
        function ComputeHeatConductivitiyTransmissibilities(obj, CondEff)
            % Harmonic average of effective heat conductivity.
            % For now, we assume that heat conductivity is isotropic.
            % This means that CondEff is only one-column vector.
            Cx = reshape(CondEff(:,1), obj.Nx, obj.Ny, obj.Nz);
            Cy = reshape(CondEff(:,1), obj.Nx, obj.Ny, obj.Nz);
            Cz = reshape(CondEff(:,1), obj.Nx, obj.Ny, obj.Nz);
            
            CHx = zeros(obj.Nx+1, obj.Ny, obj.Nz);
            CHy = zeros(obj.Nx, obj.Ny+1, obj.Nz);
            CHz = zeros(obj.Nx, obj.Ny, obj.Nz+1);
            CHx(2:obj.Nx,:,:) = 2*Cx(1:obj.Nx-1,:,:).*Cx(2:obj.Nx,:,:)./(Cx(1:obj.Nx-1,:,:)+Cx(2:obj.Nx,:,:));
            CHy(:,2:obj.Ny,:) = 2*Cy(:,1:obj.Ny-1,:).*Cy(:,2:obj.Ny,:)./(Cy(:,1:obj.Ny-1,:)+Cy(:,2:obj.Ny,:));
            CHz(:,:,2:obj.Nz) = 2*Cz(:,:,1:obj.Nz-1).*Cz(:,:,2:obj.Nz)./(Cy(:,:,1:obj.Nz-1)+Cz(:,:,2:obj.Nz));
            
            % Transmissibility
            obj.condTrans_x(2:obj.Nx,:,:) = obj.Ax./obj.dx.*CHx(2:obj.Nx,:,:);
            obj.condTrans_y(:,2:obj.Ny,:) = obj.Ay./obj.dy.*CHy(:,2:obj.Ny,:);
            obj.condTrans_z(:,:,2:obj.Nz) = obj.Az./obj.dz.*CHz(:,:,2:obj.Nz);
        end
        function AddCoordinates(obj)
        end
        function AddGridCoordinates(obj)
        end
       function ComputeDepth(obj, alpha, Thickness, index)
            if (index) % Reservoir
                obj.Depth = max(obj.fracmesh.elements.centroid(:,3)) - obj.fracmesh.elements.centroid(:,3);
            else % Fracture
                obj.Depth = Thickness - obj.fracmesh.elements.centroid(:,3);

            end
        end
        function AssignNeighbours(obj)
            obj.Neighbours = [obj.fracmesh.faces.inner.upstream obj.fracmesh.faces.inner.downstream];
        end
    end
end
